# Copy to .env and fill what you need. Everything works with NO keys (offline demo mode).

# ---- AI: mock (no key) | anthropic | openai (also Gemini / Groq via OPENAI_BASE_URL) ----
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL=gemini-flash-latest
LLM_TIMEOUT=20

# ---- WhatsApp: console (print only) | meta | twilio ----
WA_MODE=console
META_TOKEN=
META_PHONE_ID=
META_VERIFY_TOKEN=verify-me
META_APP_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
SALES_REP_PHONE=+97330000001
MANAGER_PHONE=+97330000002

# ---- CRM: local (SQLite) | zoho ----
CRM_MODE=local
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_URL=https://www.zohoapis.com

# ---- Email: console | smtp ----
EMAIL_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

PUBLIC_BASE_URL=http://localhost:8000
SECRET_KEY=change-me
