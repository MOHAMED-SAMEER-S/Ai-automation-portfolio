      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst email = String(b.email || '').trim().toLowerCase();\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) throw new Error('invalid email');\nreturn [{ json: { email, name: b.name || null, language: ['en','ar','both'].includes(b.language) ? b.language : 'en', interest: b.interest || null } }];"
      },
      "id": "61f413b9-4ea0-4edb-8ac1-988e38134a10",
